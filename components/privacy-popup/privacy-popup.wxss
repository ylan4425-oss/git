.pmask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.pdialog {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
}
.ptitle {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}
.pcontent {
  font-size: 27rpx;
  line-height: 1.6;
  color: #374151;
}
.psub {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 25rpx;
}
.plink {
  color: #2563eb;
}
.pbtns {
  display: flex;
  margin-top: 32rpx;
  gap: 20rpx;
}
.pbtn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 2.4;
}
.pbtn-cancel {
  background: #f3f4f6;
  color: #6b7280;
}
.pbtn-agree {
  background: #6366f1;
  color: #fff;
}
